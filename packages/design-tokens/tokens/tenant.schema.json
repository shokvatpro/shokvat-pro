{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shokfat.pro/schemas/tenant-branding.json",
  "title": "Tenant branding overrides (allow-list)",
  "description": "The ONLY keys a medical center may customize. Status colors, fonts, layout and platform identity are locked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["displayNameAr", "displayNameEn"],
  "properties": {
    "displayNameAr": { "type": "string", "minLength": 2, "maxLength": 60 },
    "displayNameEn": { "type": "string", "minLength": 2, "maxLength": 60 },
    "accentColor":   { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "logoLightKey":  { "type": "string", "maxLength": 300 },
    "logoDarkKey":   { "type": "string", "maxLength": 300 },
    "subdomain":     { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{1,30}[a-z0-9])$" },
    "emailSenderName": { "type": "string", "maxLength": 60 }
  }
}
